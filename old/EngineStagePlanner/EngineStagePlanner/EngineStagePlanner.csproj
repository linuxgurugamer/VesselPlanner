<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{C2C3F80A-3C84-4A02-9A3B-78B264F43001}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>EngineStagePlanner</RootNamespace>
    <AssemblyName>EngineStagePlanner</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <KSP_ROOT Condition="'$(KSP_ROOT)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSP_ROOT>
    <KSP_MANAGED>$(KSP_ROOT)\KSP_x64_Data\Managed</KSP_MANAGED>
    <TargetFrameworkProfile />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(KSPDIR)\KSP_x64_Data\Managed\Assembly*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(KSPDIR)\KSP_x64_Data\Managed\UnityEngine*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyVersion.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AssemblyVersion.tt</DependentUpon>
    </Compile>
    <Compile Include="Core\TankModels.cs" />
    <Compile Include="Core\TankPlanner.cs" />
    <Compile Include="InstallChecker.cs" />
    <Compile Include="KSP\EditorPartSpawner.cs" />
    <Compile Include="KSP\TankDatabase.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Core\Models.cs" />
    <Compile Include="Core\StageSolver.cs" />
    <Compile Include="Core\PlannerEngine.cs" />
    <Compile Include="Core\ExistingStageSimulator.cs" />
    <Compile Include="KSP\EngineDatabase.cs" />
    <Compile Include="KSP\EditorStageScanner.cs" />
    <Compile Include="KSP\KspResourceVolume.cs" />
    <Compile Include="UI\PlannerWindow.cs" />
    <Compile Include="EngineStagePlannerAddon.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="AssemblyVersion.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>AssemblyVersion.cs</LastGenOutput>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <Target Name="CopyToGameData" AfterTargets="Build" Condition="'$(CopyToKSP)' == 'true'">
    <MakeDir Directories="$(KSP_ROOT)\GameData\EngineStagePlanner\Plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KSP_ROOT)\GameData\EngineStagePlanner\Plugins" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <PropertyGroup>
    <PreBuildEvent>"$(DevEnvDir)\texttransform.exe" "$(ProjectDir)AssemblyVersion.tt"</PreBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>set KSPDIR=$(KSPDIR)

IF "%25KSPDIR%25"=="" (

	ECHO Configuration error - KSPDIR not specified in project.

	ECHO Either set KSPDIR environment variable or edit BetterLoadSaveGame.Common.props

	PAUSE

	GOTO DONE

)

start /D $(SolutionDir) /WAIT deploy.bat  $(TargetDir) $(TargetFileName) $(TargetName)

if $(ConfigurationName) == Release (	

	start /D $(SolutionDir) /WAIT buildRelease.bat $(TargetDir) $(TargetFileName) $(TargetName)

)
</PostBuildEvent>
  </PropertyGroup>
</Project>